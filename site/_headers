# Minimal, failure-proof header set for a fully static site with no user input
# and no dynamic code. The main pages self-host their fonts; the diagram pages
# load JetBrains Mono from Google Fonts, the only third-party request.
# Deliberately no CSP: with nothing
# to inject into, script-src 'self' would not have stopped the only plausible
# attack (a compromised repo or deploy token can publish a same-origin script),
# and the policy's exceptions were a real source of breakage.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Diagram pages are embedded same-origin by /archive. Detach the global DENY and
# re-set it to SAMEORIGIN, otherwise the browser blocks every diagram iframe.
/diagrams/*
  ! X-Frame-Options
  X-Frame-Options: SAMEORIGIN

# Rendered fresh by CI; keep visitors from holding a stale copy.
/resume.pdf
  Cache-Control: no-cache

# Font filenames are content-stable: if a file's bytes change, rename it.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Preview deployments must not compete with the production domain in search.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

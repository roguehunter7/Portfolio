#cloud-config
# Oracle Linux 10 (aarch64, UEK R8) — Always Free A1.Flex 2 OCPU / 12 GB dev box.
#
# Workloads, all zero-ingress:
#   - cloudflared tunnel (outbound)  the only way in; NSG has zero rules
#   - ttyd + tmux browser terminal   admin shell, loopback :7681, user opc
#   - DeepSeek Harness (native)      installed as opc and run on demand from
#                                    the terminal; dsh web serves loopback :3080
#   - Hermes Agent (native)          systemd *user* service for user opc
#
# Node is deliberately split: opc gets nvm (official script) for the interactive
# harness, while the Hermes gateway provisions its own managed tree under
# ~/.hermes/node so a monthly Node bump cannot break its unit. One monthly
# maintenance script (5th 03:05) updates the OS, nvm/Node/npm, DSH and Hermes,
# then reboots.
#
# Terraform template: every interpolation below is rendered by templatefile().
# Bodies that carry credentials or shell metacharacters are passed encoded, so
# the rendered scripts never contain a secret.

package_update: true
package_upgrade: true   # dnf upgrade once at first boot, before runcmd

write_files:
  # --- Network tuning -------------------------------------------------------
  # BBR only: this box has no swap, so swappiness/vfs_cache tuning is a no-op.
  - path: /etc/sysctl.d/99-devbox.conf
    content: |
      net.core.default_qdisc=fq
      net.ipv4.tcp_congestion_control=bbr

  # --- ttyd: browser terminal -> tmux "main" session ------------------------
  # 0600: the login credential is in ExecStart, so the unit file must not be
  # world-readable. Emergency backdoor if ttyd breaks = OCI serial console.
  - path: /etc/systemd/system/ttyd.service
    permissions: "0600"
    content: |
      [Unit]
      Description=ttyd web terminal (tmux main session)
      After=network-online.target

      [Service]
      User=opc
      Group=opc
      WorkingDirectory=/home/opc
      Environment=TERM=xterm-256color
      ExecStart=/usr/bin/ttyd -W -p 7681 -i 127.0.0.1 -c sreeram:${ttyd_password} /usr/bin/tmux new -A -s main
      Restart=always
      RestartSec=5
      StandardOutput=append:/var/log/ttyd.log
      StandardError=append:/var/log/ttyd.log

      [Install]
      WantedBy=multi-user.target

  # --- Monthly: the single maintenance pass ---------------------------------
  # One script for OS + nvm/Node/npm + DSH + Hermes, then reboot. No separate
  # DSH cron: the harness is on-demand, so content updates ride this cadence.
  - path: /etc/cron.d/maintenance
    permissions: "0644"
    content: |
      # Monthly: update everything, then reboot. Mirrors the Vaultwarden host.
      SHELL=/bin/bash
      PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
      5 3 5 * * root /usr/local/sbin/maintenance.sh >> /var/log/maintenance.log 2>&1

  # --- Secrets (from GitHub Actions -> Terraform) ----------------------------
  # 0600 root; read by the setup scripts. The instance-metadata copy is the
  # accepted trade-off documented in infra/oci/README.md.
  - path: /etc/cloudflared/tunnel-token
    permissions: "0600"
    encoding: b64
    content: ${tunnel_token_b64}

  - path: /etc/hermes/hermes.env
    permissions: "0600"
    encoding: b64
    content: ${hermes_env_b64}

  # Staged root-only, then installed into opc's home by provision.sh (the
  # interactive shell exports it, because there is no service EnvironmentFile).
  - path: /etc/dsh/env
    permissions: "0600"
    encoding: b64
    content: ${dsh_env_b64}

  - path: /etc/hermes/config.yaml
    permissions: "0644"
    encoding: gz+b64
    content: ${hermes_config_gzb64}

  # --- Scripts (repo files, embedded gz+b64 to fit the 32 KB metadata cap) ---
  - path: /usr/local/sbin/provision.sh
    permissions: "0755"
    encoding: gz+b64
    content: ${provision_gzb64}

  - path: /usr/local/sbin/hermes-setup.sh
    permissions: "0755"
    encoding: gz+b64
    content: ${hermes_setup_gzb64}

  - path: /usr/local/sbin/maintenance.sh
    permissions: "0755"
    encoding: gz+b64
    content: ${maintenance_gzb64}

runcmd:
  - [bash, /usr/local/sbin/provision.sh]

#cloud-config
# Phase 8: Oracle A1.Flex host — cloudflared tunnel for SSH (zero open ports).
# Terraform template: ${cloudflare_tunnel_token} / ${ssh_hostname} are rendered
# by templatefile() before cloud-init runs; bash-only vars use $${...} escapes.

package_update: true

packages:
  - curl
  - gnupg
  - jq
  - unattended-upgrades

write_files:
  - path: /etc/apt/apt.conf.d/20auto-upgrades
    content: |
      APT::Periodic::Update-Package-Lists "1";
      APT::Periodic::Unattended-Upgrade "1";
      APT::Periodic::AutocleanInterval "7";

  - path: /usr/local/sbin/configure-tunnel.sh
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euo pipefail

      # 1. Install cloudflared from Cloudflare's apt repo
      curl -fsSL https://pkg.cloudflare.com/cloudflare-main.gpg | gpg --yes --dearmor --output /usr/share/keyrings/cloudflare-main.gpg
      echo 'deb [signed-by=/usr/share/keyrings/cloudflare-main.gpg] https://pkg.cloudflare.com/cloudflared any main' > /etc/apt/sources.list.d/cloudflared.list
      apt-get update -y
      apt-get install -y cloudflared

      # 2. Decode the tunnel token (base64 JSON: {"a": accountTag, "s": secret, "t": tunnelId})
      TOKEN='${cloudflare_tunnel_token}'
      echo "$TOKEN" | base64 -d > /tmp/tunnel-token.json
      ACCOUNT_TAG="$(jq -r .a /tmp/tunnel-token.json)"
      TUNNEL_ID="$(jq -r .t /tmp/tunnel-token.json)"
      TUNNEL_SECRET="$(jq -r .s /tmp/tunnel-token.json)"
      rm -f /tmp/tunnel-token.json

      # 3. Credentials file (name must be exactly <tunnel-id>.json)
      CREDS="/etc/cloudflared/$${TUNNEL_ID}.json"
      printf '{"AccountTag":"%s","TunnelID":"%s","TunnelSecret":"%s"}' \
        "$ACCOUNT_TAG" "$${TUNNEL_ID}" "$TUNNEL_SECRET" > "$${CREDS}"
      chmod 600 "$${CREDS}"

      # 4. Ingress: only the SSH hostname is exposed; everything else 404
      cat > /etc/cloudflared/config.yml <<EOF
      tunnel: $${TUNNEL_ID}
      credentials-file: $${CREDS}
      ingress:
        - hostname: ${ssh_hostname}
          service: ssh://localhost:22
        - service: http_status:404
      EOF

      # 5. Install + start the cloudflared systemd service
      cloudflared --config /etc/cloudflared/config.yml service install
      systemctl enable --now cloudflared

runcmd:
  - [bash, /usr/local/sbin/configure-tunnel.sh]
  - [sh, -c, "sed -i 's|^//Unattended-Upgrade::Automatic-Reboot \"false\";|Unattended-Upgrade::Automatic-Reboot \"true\";|' /etc/apt/apt.conf.d/50unattended-upgrades || true"]
  - [sh, -c, "touch /var/log/cloud_init_complete"]

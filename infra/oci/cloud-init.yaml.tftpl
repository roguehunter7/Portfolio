#cloud-config
# Oracle A1.Flex dev box (Always Free 2 OCPU / 12 GB, ARM64).
#
# Workloads:
#   - cloudflared tunnel (outbound) — the only way in; NSG has zero ingress
#   - ttyd + tmux browser terminal  — admin shell (sshd is disabled)
#   - DeepSeek Harness (systemd)    — dsh web on loopback :3082 behind the
#                                     dsh-full-remote auth proxy on :3080,
#                                     which is the cloudflared target
#   - Hermes Agent (Docker)         — Telegram polling + DeepSeek API, no port
#
# Maintenance: /etc/cron.d/maintenance runs on the 5th at 03:05 — pull the
# Hermes image, update DSH, upgrade packages, then reboot. Same cycle as the
# GCP Vaultwarden host (infra/main.tf), so both boxes move together.
#
# Terraform template: every $${...} below is rendered by templatefile(). File
# bodies that contain credentials or shell metacharacters are passed in
# base64-encoded, so provision.sh itself never holds a secret.

package_update: true
package_upgrade: true   # full apt upgrade once at first boot, before packages/scripts

packages:
  - build-essential     # node-gyp for dsh-subprocess-local / node-pty
  - ca-certificates
  - cron                # monthly maintenance job (/etc/cron.d/maintenance)
  - curl
  - gh                  # workflow dispatch + repo work from the box
  - git
  - gnupg
  - htop
  - jq                  # dsh-setup.sh edits the reverse-proxy state file with it
  - python3-pip
  - ripgrep
  - tmux
  - ttyd
  - ufw
  - vim

write_files:
  # --- Network tuning -------------------------------------------------------
  # BBR only: this box has no swap, so a swappiness/vfs_cache_pressure tune
  # would be a no-op. BBR helps the tunnel + DeepSeek API traffic.
  - path: /etc/sysctl.d/99-devbox.conf
    content: |
      net.core.default_qdisc=fq
      net.ipv4.tcp_congestion_control=bbr

  # --- Monthly maintenance: update everything, then reboot ----------------
  # Same cycle as the Vaultwarden host (infra/main.tf): 5th of the month, 03:05.
  # cron rather than a systemd timer for parity with that box, and because the
  # whole job is "update the three workloads, upgrade the OS, reboot".
  # The reboot is safe because every workload is supervised: dsh-web.service
  # (Restart=always) and the Hermes container (restart: unless-stopped) both
  # come back on their own.
  - path: /usr/local/sbin/monthly-maintenance.sh
    permissions: "0755"
    content: |
      #!/bin/bash
      # Monthly maintenance: update containers + DSH + OS packages, then reboot.
      # No `set -e`: a failing update must not leave the box un-rebooted and
      # drifting. Everything is logged to /var/log/monthly-maintenance.log.
      LOG=/var/log/monthly-maintenance.log
      exec >>"$LOG" 2>&1
      echo "=== $(date -Is) monthly maintenance start ==="

      # Hermes: the image tracks :latest, so pull picks up the newest release.
      if [ -f /opt/hermes/docker-compose.yml ]; then
        docker compose -f /opt/hermes/docker-compose.yml pull --quiet
        docker compose -f /opt/hermes/docker-compose.yml up -d
      fi

      # DeepSeek Harness + its reverse-proxy plugin (idempotent installer).
      [ -x /usr/local/sbin/dsh-setup.sh ] && bash /usr/local/sbin/dsh-setup.sh

      # OS packages, including cloudflared from its own apt repo.
      export DEBIAN_FRONTEND=noninteractive
      apt-get update -y
      apt-get upgrade -y

      echo "=== $(date -Is) maintenance complete, rebooting ==="
      systemctl reboot

  - path: /etc/cron.d/maintenance
    permissions: "0644"
    content: |
      # Monthly maintenance: update containers + OS, then reboot.
      # Mirrors the Vaultwarden host so both boxes ride the same cycle.
      SHELL=/bin/bash
      PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
      5 3 5 * * root /usr/local/sbin/monthly-maintenance.sh

  # --- ttyd systemd unit: browser terminal -> tmux "main" session -----------
  # 0600: the login credential is in ExecStart, so the unit file must not be
  # world-readable. Emergency backdoor if ttyd/DSH break = OCI serial console.
  - path: /etc/systemd/system/ttyd.service
    permissions: "0600"
    content: |
      [Unit]
      Description=ttyd web terminal (tmux main session)
      After=network-online.target

      [Service]
      User=ubuntu
      Group=ubuntu
      WorkingDirectory=/home/ubuntu
      Environment=TERM=xterm-256color
      ExecStart=/usr/bin/ttyd -W -p 7681 -i 127.0.0.1 -c sreeram:${ttyd_password} /usr/bin/tmux new -A -s main
      Restart=always
      RestartSec=5
      StandardOutput=append:/var/log/ttyd.log
      StandardError=append:/var/log/ttyd.log

      [Install]
      WantedBy=multi-user.target

  # --- Hermes Agent (official image; nothing Hermes needs is on the host) ---
  # /opt/hermes is mounted at /opt/data in the container: config, sessions,
  # skills and memories all live there, so the image stays replaceable.
  - path: /opt/hermes/docker-compose.yml
    permissions: "0644"
    encoding: b64
    content: ${hermes_compose_b64}

  - path: /opt/hermes/config.yaml
    permissions: "0644"
    encoding: b64
    content: ${hermes_config_b64}

  # Secrets from GitHub Actions -> Terraform -> here. Root-owned 0600; the
  # instance metadata copy is the accepted trade-off (see infra/oci/README.md).
  - path: /opt/hermes/.env
    permissions: "0600"
    encoding: b64
    content: ${hermes_env_b64}

  # DeepSeek Harness credentials. The credentials provider layers the inherited
  # process environment ABOVE ~/.dsh/.credentials.yaml, so this makes a rebuilt
  # box usable immediately instead of waiting for a manual entry in Settings.
  # Rotating the key means updating the GitHub secret + rebuilding, or editing
  # this file and restarting dsh-web (the env deliberately wins over the store).
  - path: /etc/dsh-web.env
    permissions: "0600"
    encoding: b64
    content: ${dsh_env_b64}

  - path: /usr/local/sbin/dsh-setup.sh
    permissions: "0755"
    encoding: b64
    content: ${dsh_setup_b64}

  - path: /usr/local/sbin/provision.sh
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euo pipefail

      # =======================================================================
      # One-shot provisioning. Order matters: cloudflared first (bootstraps
      # admin access through the tunnel), then the workloads, then hardening
      # LAST so a failure never locks us out. Emergency backdoor if anything
      # fails: OCI serial console.
      # =======================================================================

      # --- cloudflared tunnel (remote-managed; routes live in the dashboard) --
      sudo mkdir -p --mode=0755 /usr/share/keyrings
      curl -fsSL https://pkg.cloudflare.com/cloudflare-main.gpg | sudo tee /usr/share/keyrings/cloudflare-main.gpg >/dev/null
      echo 'deb [signed-by=/usr/share/keyrings/cloudflare-main.gpg] https://pkg.cloudflare.com/cloudflared any main' | sudo tee /etc/apt/sources.list.d/cloudflared.list >/dev/null
      sudo apt-get update -y
      sudo apt-get install -y cloudflared
      # Token is base64 JSON {"a": accountTag, "t": tunnelId, "s": secret}.
      sudo cloudflared service install '${cloudflare_tunnel_token}'
      sudo systemctl enable --now cloudflared

      # --- Node.js LTS via nvm (DeepSeek Harness runs on it) -----------------
      # User-level, no sudo. dsh-setup.sh resolves the bin dir when it writes
      # the systemd unit, so no version is hardcoded anywhere.
      sudo -u ubuntu bash -lc '
        export NVM_DIR="$HOME/.nvm"
        curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.6/install.sh | bash
        . "$NVM_DIR/nvm.sh"
        nvm install --lts
        nvm alias default lts/*
      '

      # --- git identity + repo checkout -------------------------------------
      # The dev box exists to work on this repo; DSH starts in it.
      sudo -u ubuntu git config --global user.name 'roguehunter7'
      sudo -u ubuntu git config --global user.email 'krsreeram007@gmail.com'
      if [ ! -d /home/ubuntu/Portfolio/.git ]; then
        sudo -u ubuntu git clone --depth=1 https://github.com/roguehunter7/Portfolio.git /home/ubuntu/Portfolio || true
      fi

      # --- Docker Engine + compose plugin (official repo) -------------------
      # Hermes runs as the official image, so the host gets no Python/Node/
      # Chromium for it — only the runtime.
      sudo install -m 0755 -d /etc/apt/keyrings
      curl -fsSL https://download.docker.com/linux/ubuntu/gpg | sudo gpg --dearmor --yes -o /etc/apt/keyrings/docker.gpg
      sudo chmod a+r /etc/apt/keyrings/docker.gpg
      echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" | sudo tee /etc/apt/sources.list.d/docker.list >/dev/null
      sudo apt-get update -y
      sudo apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
      sudo systemctl enable --now docker

      # --- Hermes (compose + config + .env written by write_files) ----------
      sudo docker compose -f /opt/hermes/docker-compose.yml up -d

      # --- DeepSeek Harness: service + authenticated edge proxy -------------
      sudo bash /usr/local/sbin/dsh-setup.sh

      # --- Services ---------------------------------------------------------
      sudo systemctl daemon-reload
      sudo systemctl enable --now cron      # monthly maintenance
      sudo systemctl enable --now ttyd

      # --- Apply sysctl tuning ---------------------------------------------
      sudo sysctl --system

      # --- Verify the tunnel registered (wait up to 120s) -------------------
      for i in $(seq 1 24); do
        if sudo journalctl -u cloudflared --no-pager -n 200 2>/dev/null \
             | grep -q "Registered tunnel connection"; then
          echo "cloudflared registered with Cloudflare"
          break
        fi
        sleep 5
      done

      # --- HARDEN LAST: deny incoming, keep outbound, sshd off --------------
      sudo systemctl disable --now ssh || true
      sudo ufw default deny incoming
      sudo ufw default allow outgoing
      sudo ufw allow in on lo
      sudo ufw --force enable

      touch /var/log/cloud_init_complete   # sentinel only if we get here

runcmd:
  - [bash, /usr/local/sbin/provision.sh]

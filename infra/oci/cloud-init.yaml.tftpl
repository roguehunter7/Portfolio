#cloud-config
# Ubuntu 24.04 (aarch64) — Always Free A1.Flex 2 OCPU / 12 GB dev box.
#
# Workloads, all zero-ingress:
#   - cloudflared tunnel (outbound)  the only way in; NSG has zero rules
#   - ttyd browser terminal          admin shell, loopback :7681, user ubuntu
#   - DeepSeek Harness              installed by provision.sh as ubuntu (nvm),
#                                    run on demand from the terminal; dsh web
#                                    serves loopback :3080
#   - Hermes Agent (Docker)          official image, loopback API only
#
# Node for the interactive harness comes from nvm (official script); Hermes runs
# in the official image and carries its own Node/Python/Chromium, so a monthly
# Node bump cannot touch the gateway. One monthly maintenance script (5th
# 03:05) updates the OS, nvm/Node/npm and the Hermes image, then reboots.
#
# Terraform template: every interpolation below is rendered by templatefile().
# Bodies that carry credentials or shell metacharacters are passed encoded, so
# the rendered scripts never contain a secret.

package_update: true
package_upgrade: false  # provision.sh upgrades after ttyd is reachable

write_files:
  # --- Network tuning -------------------------------------------------------
  # BBR only: this box has no swap, so swappiness/vfs_cache tuning is a no-op.
  - path: /etc/sysctl.d/99-devbox.conf
    content: |
      net.core.default_qdisc=fq
      net.ipv4.tcp_congestion_control=bbr

  # --- ttyd: browser terminal -> login shell --------------------------------
  # No multiplexer: ttyd owns the PTY and pumps bytes to xterm.js in the
  # browser, so a plain bash session is enough and the wheel reaches xterm.js
  # (browser scrollback). bash --login gives the shell nvm's node/dsh on PATH
  # and DEEPSEEK_API_KEY from ~/.dsh/env. Nothing survives a reboot; sessions
  # are server-side, so dsh-tui resumes with --resume.
  # 0600: the login credential is in ExecStart, so the unit file must not be
  # world-readable. Emergency backdoor if ttyd breaks = OCI serial console.
  - path: /etc/systemd/system/ttyd.service
    permissions: "0600"
    content: |
      [Unit]
      Description=ttyd web terminal (login shell)
      After=network-online.target

      [Service]
      User=ubuntu
      Group=ubuntu
      WorkingDirectory=/home/ubuntu
      Environment=TERM=xterm-256color
      # -W: writable. --login: source /home/ubuntu/.bashrc, so the shell has
      # nvm's node/dsh and the DSH key without pinning a version path here.
      ExecStart=/usr/bin/ttyd -W -p 7681 -i 127.0.0.1 -c sreeram:${ttyd_password} /usr/bin/bash --login
      Restart=always
      RestartSec=5
      StandardOutput=append:/var/log/ttyd.log
      StandardError=append:/var/log/ttyd.log

      [Install]
      WantedBy=multi-user.target

  # --- Monthly: the single maintenance pass ---------------------------------
  # One script for OS + nvm/Node/npm + the Hermes image, then reboot. DSH is
  # deliberately not installed or updated here; manage it by hand.
  - path: /etc/cron.d/maintenance
    permissions: "0644"
    content: |
      # Monthly: update everything, then reboot. Mirrors the Vaultwarden host.
      SHELL=/bin/bash
      PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
      5 3 5 * * root /usr/local/sbin/maintenance.sh >> /var/log/maintenance.log 2>&1

  # --- Secrets (from GitHub Actions -> Terraform) ----------------------------
  # 0600 root; read by the setup scripts. The instance-metadata copy is the
  # accepted trade-off documented in infra/oci/README.md.
  - path: /etc/cloudflared/tunnel-token
    permissions: "0600"
    encoding: b64
    content: ${tunnel_token_b64}

  - path: /etc/hermes/hermes.env
    permissions: "0600"
    encoding: b64
    content: ${hermes_env_b64}

  # Staged root-only, then installed into ubuntu's home by provision.sh (the
  # interactive shell exports it, because there is no service EnvironmentFile).
  - path: /etc/dsh/env
    permissions: "0600"
    encoding: b64
    content: ${dsh_env_b64}

  - path: /etc/hermes/config.yaml
    permissions: "0644"
    encoding: gz+b64
    content: ${hermes_config_gzb64}

  # --- Scripts (repo files, embedded gz+b64 to fit the 32 KB metadata cap) ---
  - path: /usr/local/sbin/provision.sh
    permissions: "0755"
    encoding: gz+b64
    content: ${provision_gzb64}

  - path: /opt/hermes/docker-compose.yml
    permissions: "0644"
    encoding: gz+b64
    content: ${hermes_compose_gzb64}

  - path: /usr/local/sbin/maintenance.sh
    permissions: "0755"
    encoding: gz+b64
    content: ${maintenance_gzb64}

runcmd:
  - [bash, /usr/local/sbin/provision.sh]

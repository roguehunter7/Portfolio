#cloud-config
# Phase 8: Oracle A1.Flex host — cloudflared tunnel for SSH (zero open ports).
# Terraform template: ${cloudflare_tunnel_token} is rendered by templatefile()
# before cloud-init runs. ssh.sreeramkr.com is routed to the tunnel in the
# Cloudflare Zero Trust dashboard (remote-managed tunnel; no local config.yml).

package_update: true

packages:
  - curl
  - gnupg
  - jq
  - unattended-upgrades

write_files:
  - path: /etc/apt/apt.conf.d/20auto-upgrades
    content: |
      APT::Periodic::Update-Package-Lists "1";
      APT::Periodic::Unattended-Upgrade "1";
      APT::Periodic::AutocleanInterval "7";

  - path: /usr/local/sbin/configure-tunnel.sh
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euo pipefail

      # 1. Install cloudflared from Cloudflare's apt repo (official instructions)
      sudo mkdir -p --mode=0755 /usr/share/keyrings
      curl -fsSL https://pkg.cloudflare.com/cloudflare-main.gpg | sudo tee /usr/share/keyrings/cloudflare-main.gpg >/dev/null
      echo 'deb [signed-by=/usr/share/keyrings/cloudflare-main.gpg] https://pkg.cloudflare.com/cloudflared any main' | sudo tee /etc/apt/sources.list.d/cloudflared.list >/dev/null
      sudo apt-get update -y
      sudo apt-get install -y cloudflared

      # 2. Register the REMOTELY-MANAGED tunnel (created in the Zero Trust
      #    dashboard). The token is base64 JSON {"a": accountTag, "t": tunnelId,
      #    "s": secret}; ingress routes live in the dashboard, not in a local
      #    config.yml.
      TOKEN='${cloudflare_tunnel_token}'
      sudo cloudflared service install "$TOKEN"
      sudo systemctl enable --now cloudflared

      # 3. Verify the tunnel actually registered (not just "service started").
      #    cloudflared logs "Registered tunnel connection" once it reaches
      #    Cloudflare's edge; wait up to 120s, else fail loudly.
      for i in $(seq 1 24); do
        if sudo journalctl -u cloudflared --no-pager -n 200 2>/dev/null \
             | grep -q "Registered tunnel connection"; then
          echo "cloudflared registered with Cloudflare"
          touch /var/log/cloud_init_complete   # sentinel only on SUCCESS
          exit 0
        fi
        sleep 5
      done
      echo "ERROR: cloudflared never registered a tunnel connection" >&2
      sudo journalctl -u cloudflared --no-pager -n 40 >&2 || true
      exit 1

runcmd:
  - [bash, /usr/local/sbin/configure-tunnel.sh]
  - [sh, -c, "sed -i 's|^//Unattended-Upgrade::Automatic-Reboot \"false\";|Unattended-Upgrade::Automatic-Reboot \"true\";|' /etc/apt/apt.conf.d/50unattended-upgrades || true"]

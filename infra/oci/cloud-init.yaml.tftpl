#cloud-config
# Oracle Linux 10 (aarch64, UEK R8) — Always Free A1.Flex 2 OCPU / 12 GB dev box.
#
# Workloads, all zero-ingress:
#   - cloudflared tunnel (outbound)  the only way in; NSG has zero rules
#   - ttyd + tmux browser terminal   admin shell, loopback :7681, user opc
#   - DeepSeek Harness (systemd)     dsh web on loopback :3082 behind the
#                                    dsh-full-remote auth proxy on :3080,
#                                    which is the cloudflared target
#   - Hermes Agent (native)          systemd *user* service for user hermes
#
# No container runtime: Hermes runs natively, so there is no Docker and no
# podman. Maintenance: /etc/cron.d/maintenance on the 5th at 03:05 (dnf upgrade
# + reboot — the same cycle as the GCP Vaultwarden host) and /etc/cron.d/dsh-update
# on Sundays at 02:05 (DSH alpha refresh, because the harness is in developer
# preview and moves faster than any distro repo).
#
# Terraform template: every $${...} below is rendered by templatefile(). Bodies
# that carry credentials or shell metacharacters are passed encoded, so the
# rendered scripts never contain a secret.

package_update: true
package_upgrade: true   # dnf upgrade once at first boot, before runcmd

write_files:
  # --- Network tuning -------------------------------------------------------
  # BBR only: this box has no swap, so swappiness/vfs_cache tuning is a no-op.
  - path: /etc/sysctl.d/99-devbox.conf
    content: |
      net.core.default_qdisc=fq
      net.ipv4.tcp_congestion_control=bbr

  # --- ttyd: browser terminal -> tmux "main" session ------------------------
  # 0600: the login credential is in ExecStart, so the unit file must not be
  # world-readable. Emergency backdoor if ttyd/DSH break = OCI serial console.
  - path: /etc/systemd/system/ttyd.service
    permissions: "0600"
    content: |
      [Unit]
      Description=ttyd web terminal (tmux main session)
      After=network-online.target

      [Service]
      User=opc
      Group=opc
      WorkingDirectory=/home/opc
      Environment=TERM=xterm-256color
      ExecStart=/usr/bin/ttyd -W -p 7777 -i 127.0.0.1 -c sreeram:${ttyd_password} /usr/bin/tmux new -A -s main
      Restart=always
      RestartSec=5
      StandardOutput=append:/var/log/ttyd.log
      StandardError=append:/var/log/ttyd.log

      [Install]
      WantedBy=multi-user.target

  # --- Monthly: OS + cloudflared + Node patch, then reboot ------------------
  # `;` separators: a failed upgrade must not skip the reboot. The reboot is
  # safe because every workload is supervised (dsh-web Restart=always, the
  # Hermes gateway is a lingered user service, cloudflared/ttyd are enabled).
  - path: /etc/cron.d/maintenance
    permissions: "0644"
    content: |
      # Monthly maintenance: dnf upgrade, then reboot. Mirrors the Vaultwarden host.
      SHELL=/bin/bash
      PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
      5 3 5 * * root dnf -y upgrade ; systemctl reboot

  # --- Weekly: DeepSeek Harness alpha refresh --------------------------------
  # One hour before the monthly window so a reboot can never land mid-update.
  - path: /etc/cron.d/dsh-update
    permissions: "0644"
    content: |
      # Weekly: refresh DSH from the alpha channel and restart the service.
      SHELL=/bin/bash
      PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
      5 2 * * 0 root /usr/local/sbin/dsh-update.sh >> /var/log/dsh-update.log 2>&1

  # --- Secrets (from GitHub Actions -> Terraform) ----------------------------
  # 0600 root; read by the setup scripts. The instance-metadata copy is the
  # accepted trade-off documented in infra/oci/README.md.
  - path: /etc/cloudflared/tunnel-token
    permissions: "0600"
    encoding: b64
    content: ${tunnel_token_b64}

  - path: /etc/hermes/hermes.env
    permissions: "0600"
    encoding: b64
    content: ${hermes_env_b64}

  - path: /etc/dsh-web.env
    permissions: "0600"
    encoding: b64
    content: ${dsh_env_b64}

  - path: /etc/hermes/config.yaml
    permissions: "0644"
    encoding: gz+b64
    content: ${hermes_config_gzb64}

  # --- Scripts (repo files, embedded gz+b64 to fit the 32 KB metadata cap) ---
  - path: /usr/local/sbin/provision.sh
    permissions: "0755"
    encoding: gz+b64
    content: ${provision_gzb64}

  - path: /usr/local/sbin/dsh-setup.sh
    permissions: "0755"
    encoding: gz+b64
    content: ${dsh_setup_gzb64}

  - path: /usr/local/sbin/hermes-setup.sh
    permissions: "0755"
    encoding: gz+b64
    content: ${hermes_setup_gzb64}

  - path: /usr/local/sbin/dsh-update.sh
    permissions: "0755"
    encoding: gz+b64
    content: ${dsh_update_gzb64}

runcmd:
  - [bash, /usr/local/sbin/provision.sh]

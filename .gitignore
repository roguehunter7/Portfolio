# Local .terraform directories
**/.terraform/*

# .tfstate files (CRITICAL: DO NOT COMMIT)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are used for secret variables
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore compiled resume PDF
resume.pdf
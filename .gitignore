# Local .terraform directories
**/.terraform/*

# .tfstate files (CRITICAL: DO NOT COMMIT)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are used for secret variables
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.claude/*

# Ignore CLI configuration files
.terraformrc
terraform.rc
package*.json
repomix-output.xml
# Ignore compiled resume PDF
site/resume.pdf
# Playwright MCP tool artifacts
.playwright-mcp/
reasonix.toml
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.VolumeIcon.icns

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.lnk
desktop.ini

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (IntelliJ, PyCharm, WebStorm, etc.)
.idea/
*.iws
*.iml
*.ipr

# Vim / Nano / Sublime
.*.sw[a-p]
.*.un~
Session.vim
*.sublime-project
*.sublime-workspace

# ==============================================================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.pub
*.p12
*.pfx
secrets.yaml

